* {
    font-family: "Helvetica Neue", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    color: #eaf1fb;
}

QMainWindow,
QWidget#appRoot {
    background: #091321;
}

QFrame#playArea,
QFrame#sidebar {
    background: #101c2e;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 22px;
}

QLabel#eyebrow {
    color: #43d9c2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#brandTitle {
    color: #f7fbff;
    font-size: 25px;
    font-weight: 750;
}

QLabel#turnBadge {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#turnBadge[side="black"] {
    color: #b8fff4;
    background: rgba(67, 217, 194, 0.12);
    border: 1px solid rgba(67, 217, 194, 0.34);
}

QLabel#turnBadge[side="white"] {
    color: #fff2cf;
    background: rgba(255, 211, 106, 0.11);
    border: 1px solid rgba(255, 211, 106, 0.30);
}

QFrame#statusCard {
    background: #17263b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QLabel#statusTitle {
    color: #ffffff;
    font-size: 19px;
    font-weight: 750;
}

QLabel#statusDetail {
    color: #9db0c9;
    font-size: 12px;
    line-height: 1.35;
}

QLabel#phasePill {
    color: #74ead9;
    background: rgba(67, 217, 194, 0.09);
    border: 1px solid rgba(67, 217, 194, 0.22);
    border-radius: 9px;
    min-height: 30px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#sectionLabel {
    color: #7187a4;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QLabel#counterLabel {
    color: #43d9c2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

QComboBox {
    min-height: 39px;
    padding: 0 13px;
    background: #17263b;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    color: #dbe7f5;
    font-size: 12px;
}

QComboBox:hover,
QComboBox:focus {
    border-color: rgba(67, 217, 194, 0.55);
    background: #1a2c44;
}

QComboBox:disabled {
    color: #53657d;
    background: #111d2e;
}

QComboBox::drop-down {
    border: 0;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(:/cli_plus/chevron-down.svg);
    width: 12px;
    height: 8px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    color: #eaf1fb;
    background: #17263b;
    selection-background-color: #255168;
    border: 1px solid #30435c;
    outline: 0;
    padding: 5px;
}

QPushButton {
    min-height: 39px;
    padding: 0 12px;
    color: #b9c9dc;
    background: #17263b;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton:hover {
    color: #ffffff;
    background: #213650;
    border-color: rgba(255, 255, 255, 0.18);
}

QPushButton:pressed {
    background: #0f1c2d;
}

QPushButton:disabled {
    color: #4d5d72;
    background: #111c2c;
    border-color: rgba(255, 255, 255, 0.04);
}

QPushButton#primaryButton {
    color: #071a1b;
    background: #43d9c2;
    border: 1px solid #69ead7;
}

QPushButton#primaryButton:hover {
    background: #63e6d2;
}

QListWidget#moveLog {
    color: #9fb2ca;
    background: #0c1727;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 7px;
    outline: 0;
    font-family: "SF Mono", "JetBrains Mono", monospace;
    font-size: 10px;
}

QListWidget#moveLog::item {
    min-height: 28px;
    padding: 2px 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.035);
}

QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 5px 1px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    background: #32445b;
    border-radius: 3px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#helpText {
    color: #60758f;
    font-size: 10px;
    line-height: 1.4;
}

QMessageBox {
    background: #101c2e;
}

QMessageBox QLabel {
    color: #eaf1fb;
}
