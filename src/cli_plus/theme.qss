/* ── ZZmazon · 水墨宣纸主题 ─────────────────────────────── */

* {
    font-family: "Kaiti SC", "STKaiti", "KaiTi", "Kaiti TC",
                 "Songti SC", "Noto Serif CJK SC", "PingFang SC", sans-serif;
    color: #3a352c;
}

QMainWindow,
QWidget#appRoot {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f2e9d4, stop:1 #e7dcc0);
}

QFrame#playArea,
QFrame#sidebar {
    background: rgba(250, 244, 229, 0.72);
    border: 1px solid #cfc09f;
    border-radius: 20px;
}

QLabel#eyebrow {
    color: #a04f2c;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
}

QLabel#brandTitle {
    color: #2e2921;
    font-size: 24px;
    font-weight: 700;
}

QLabel#turnBadge {
    min-height: 40px;
    padding: 0 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#turnBadge[side="black"] {
    color: #f0e6ce;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a4238, stop:1 #2c2721);
    border: 1px solid #1b1712;
}

QLabel#turnBadge[side="white"] {
    color: #46402f;
    background: #fbf5e6;
    border: 1px solid #cdbd97;
}

QFrame#statusCard {
    background: #f8f0dd;
    border: 1px solid #dbcda9;
    border-radius: 15px;
}

QLabel#statusTitle {
    color: #262019;
    font-size: 18px;
    font-weight: 650;
}

QLabel#statusDetail {
    color: #7b6c51;
    font-size: 12px;
}

QLabel#phasePill {
    color: #993a22;
    background: rgba(153, 58, 34, 0.08);
    border: 1px solid rgba(153, 58, 34, 0.35);
    border-radius: 10px;
    min-height: 28px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#sectionLabel {
    color: #8b7a58;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
}

QLabel#counterLabel {
    color: #993a22;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QComboBox {
    min-height: 37px;
    padding: 0 12px;
    background: #f7efdc;
    border: 1px solid #cfc19f;
    border-radius: 9px;
    color: #3a352c;
    font-size: 12px;
}

QComboBox:hover,
QComboBox:focus {
    border-color: #a04f2c;
    background: #faf3e1;
}

QComboBox:disabled {
    color: #b3a583;
    background: #efe6cf;
    border-color: #d8cbab;
}

QComboBox::drop-down {
    border: 0;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(:/cli_plus/chevron-down.svg);
    width: 12px;
    height: 8px;
    margin-right: 9px;
}

QComboBox QAbstractItemView {
    color: #3a352c;
    background: #fbf4e2;
    selection-background-color: #e9dab3;
    selection-color: #2e2921;
    border: 1px solid #cdbb92;
    outline: 0;
    padding: 4px;
}

QPushButton {
    min-height: 37px;
    padding: 0 12px;
    color: #453d2e;
    background: #f6eeda;
    border: 1px solid #c9ba97;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton:hover {
    color: #2e2921;
    background: #f9f2df;
    border-color: #a04f2c;
}

QPushButton:pressed {
    background: #ecdfc0;
}

QPushButton:disabled {
    color: #b7ab8e;
    background: #efe7d2;
    border-color: #ded2b4;
}

QPushButton#primaryButton {
    color: #f7ecd8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #b04732, stop:1 #93331f);
    border: 1px solid #7c2a18;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #c05439, stop:1 #a03c25);
}

QPushButton#primaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #93331f, stop:1 #872d1a);
}

QListWidget#moveLog {
    color: #6f6249;
    background: #f2e9d1;
    border: 1px solid #d9cbab;
    border-radius: 11px;
    padding: 6px;
    outline: 0;
    font-size: 11px;
}

QListWidget#moveLog::item {
    min-height: 26px;
    padding: 2px 6px;
    border-bottom: 1px solid #e5d9bd;
}

QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 4px 1px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    background: #c6b48d;
    border-radius: 3px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#helpText {
    color: #8d7d5f;
    font-size: 11px;
}

QMessageBox {
    background: #f4ecd9;
}

QMessageBox QLabel {
    color: #3a352c;
}

/* ── 终局之契:胜利/失败卡片 ─────────────────────────────── */
QFrame#gameOverCard {
    background: qlineargradient(x1:0, y1:0, x2:0.35, y2:1,
                stop:0 #f7f0dd, stop:0.55 #efe5cb, stop:1 #e5d7b4);
    border: 1px solid #b9a67d;
    border-radius: 18px;
}

QLabel#gameOverSeal {
    background: qlineargradient(x1:0, y1:0, x2:0.3, y2:1,
                stop:0 #c8502f, stop:0.55 #a63a20, stop:1 #87290f);
    color: #f6ecd4;
    border: 2px solid #7c2410;
    border-radius: 56px;
    font-size: 56px;
    font-weight: 600;
}

QLabel#gameOverSeal[result="loss"] {
    background: qlineargradient(x1:0, y1:0, x2:0.3, y2:1,
                stop:0 #514839, stop:0.55 #3b3428, stop:1 #262119);
    color: #e6dcc2;
    border: 2px solid #17130d;
}

QLabel#gameOverTitle {
    color: #33291c;
    font-size: 26px;
    font-weight: 600;
    margin-top: 8px;
}

QLabel#gameOverSubtitle {
    color: #a04f2c;
    font-size: 14px;
    font-weight: 600;
}

QLabel#gameOverDetail {
    color: #6f5f44;
    font-size: 12px;
}

QFrame#gameOverDivider {
    border: none;
    max-height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 rgba(166,84,44,0), stop:0.5 rgba(166,84,44,190),
                stop:1 rgba(166,84,44,0));
}

#gameOverCard QPushButton {
    min-height: 36px;
    border-radius: 10px;
}
